# Copy to android/keystore.properties and fill in. NEVER commit the real one, and never
# lose the .jks it points at — Play ties your app's identity to that key forever.
#
#   keytool -genkey -v -keystore chartbreaker.jks -alias chartbreaker \
#     -keyalg RSA -keysize 2048 -validity 10000
#
storeFile=../chartbreaker.jks
storePassword=CHANGE_ME
keyAlias=chartbreaker
keyPassword=CHANGE_ME
